---
/*
 * EXPERIMENT — not part of the migration. Delete it with the rest of the theme
 * experiment; it must not reach a build.
 *
 * Four shapes for the post footer, stacked so they can be compared. The page
 * borrows the real post wrapper and the real sidebar, so the content column is
 * the width a post actually gets and the links wrap where they really wrap.
 */
import Base from '../layouts/Base.astro';
import PostFooter from '../components/PostFooter.astro';
import Sidebar from '../components/Sidebar.astro';
import { allPosts, tagCounts } from '../lib/posts';

const tags = tagCounts(await allPosts());

const link = {
    bitchute: { href: 'https://phalcon.io/bitchute', label: 'BitChute' },
    brighteon: { href: 'https://phalcon.io/brighteon', label: 'Brighteon' },
    devto: { href: 'https://dev.to/phalcon', label: 'DevTo' },
    discord: { href: 'https://phalcon.io/discord', label: 'Discord' },
    facebook: { href: 'https://phalcon.io/fb', label: 'Facebook' },
    forum: { href: 'https://phalcon.io/forum', label: 'Forum (archive)' },
    fund: { href: 'https://phalcon.io/fund', label: 'OpenCollective' },
    gab: { href: 'https://phalcon.io/gab', label: 'Gab' },
    lbry: { href: 'https://phalcon.io/lbry', label: 'LBRY' },
    linkedin: { href: 'https://phalcon.io/linkedin', label: 'LinkedIn' },
    mewe: { href: 'https://phalcon.io/mewe', label: 'MeWe' },
    reddit: { href: 'https://phalcon.io/reddit', label: 'Reddit' },
    telegram: { href: 'https://phalcon.io/telegram', label: 'Telegram' },
    v5: { href: 'https://github.com/phalcon/cphalcon/discussions', label: 'Discussions (v4,v5)' },
    v6: { href: 'https://github.com/phalcon/phalcon/discussions', label: 'Discussions (v6+)' },
    x: { href: 'https://phalcon.io/t', label: 'X (twitter)' },
    youtube: { href: 'https://phalcon.io/youtube', label: 'YouTube' },
};

/* A — all 17 links kept, one row per group. */
const optionA = [
    { label: 'Chat', links: [link.discord, link.v5, link.v6, link.forum] },
    { label: 'Support', links: [link.fund] },
    {
        label: 'Social',
        links: [
            link.telegram, link.gab, link.mewe, link.devto,
            link.reddit, link.linkedin, link.facebook, link.x,
        ],
    },
    { label: 'Videos', links: [link.bitchute, link.brighteon, link.lbry, link.youtube] },
];

/* B — 11 links. The video group collapses to the one that carries the content. */
const optionB = [
    { label: 'Chat', links: [link.discord, link.v6, link.v5, link.forum] },
    { label: 'Follow', links: [link.youtube, link.telegram, link.devto, link.reddit, link.linkedin, link.x] },
    { label: 'Support', links: [link.fund] },
];

const cases = [
    { id: 'now', note: '17 links, 4 headings, bulleted', title: 'Current' },
    { id: 'a', note: '17 links, 4 rows — nothing dropped', title: 'Option A' },
    { id: 'b', note: '11 links, 3 rows — video group collapsed', title: 'Option B' },
    { id: 'c', note: '4 links, 1 line', title: 'Option C' },
];
---

<Base title="Footer preview">
    <div class="phalcon-blog-detail">
        <h2 class="headline">Post footer — four shapes</h2>
        <p>
            Each block below is what would sit at the end of every post. The column
            width and the styling are the real ones.
        </p>

        <nav class="fp-jump">
            {cases.map((item) => (
                <a href={`#${item.id}`}>{item.title}</a>
            ))}
        </nav>

        <h3 class="fp-case" id="now">Current <span>{cases[0].note}</span></h3>
        <PostFooter />

        <hr class="fp-sep" />

        <h3 class="fp-case" id="a">Option A <span>{cases[1].note}</span></h3>
        <hr />
        {optionA.map((row) => (
            <div class="fp-row">
                <span class="fp-label">{row.label}</span>
                <span class="fp-links">
                    {row.links.map((item, index) => (
                        <Fragment>
                            {index > 0 && <span class="fp-dot">·</span>}
                            <a href={item.href}>{item.label}</a>
                        </Fragment>
                    ))}
                </span>
            </div>
        ))}
        <p class="fp-sign">&lt;3 Phalcon Team</p>

        <hr class="fp-sep" />

        <h3 class="fp-case" id="b">Option B <span>{cases[2].note}</span></h3>
        <hr />
        {optionB.map((row) => (
            <div class="fp-row">
                <span class="fp-label">{row.label}</span>
                <span class="fp-links">
                    {row.links.map((item, index) => (
                        <Fragment>
                            {index > 0 && <span class="fp-dot">·</span>}
                            <a href={item.href}>{item.label}</a>
                        </Fragment>
                    ))}
                </span>
            </div>
        ))}
        <p class="fp-sign">&lt;3 Phalcon Team</p>

        <hr class="fp-sep" />

        <h3 class="fp-case" id="c">Option C <span>{cases[3].note}</span></h3>
        <hr />
        <p class="fp-one-line">
            Questions on <a href={link.discord.href}>Discord</a> or
            <a href={link.v6.href}>GitHub Discussions</a> · videos on
            <a href={link.youtube.href}>YouTube</a> · support the project on
            <a href={link.fund.href}>OpenCollective</a>
        </p>
        <p class="fp-sign">&lt;3 Phalcon Team</p>
    </div>

    <Sidebar slot="sidebar" tags={tags} />
</Base>

<style>
    /*
     * The `--nd-*` tokens come from the theme experiment. The fallbacks keep
     * this page readable if that stylesheet is removed first.
     */
    .fp-jump {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 30px;
    }

    .fp-case {
        align-items: baseline;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 34px;
    }

    .fp-case span {
        color: var(--nd-faint, #68727e);
        font-family: var(--nd-font-mono, monospace);
        font-size: 11px;
        font-weight: 400;
        letter-spacing: 0.04em;
    }

    .fp-sep {
        border: 0;
        border-top: 1px solid var(--nd-border-strong, #e5e5e5);
        margin: 34px 0 0;
    }

    .fp-row {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
        gap: 6px 14px;
        margin-bottom: 8px;
    }

    .fp-label {
        color: var(--nd-kicker, #68727e);
        flex: 0 0 74px;
        font-family: var(--nd-font-mono, monospace);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .fp-links {
        flex: 1 1 260px;
        line-height: 1.9;
    }

    .fp-dot {
        color: var(--nd-faint, #68727e);
        margin: 0 7px;
    }

    .fp-one-line {
        line-height: 1.9;
    }

    .fp-sign {
        color: var(--nd-faint, #68727e);
        margin-top: 14px;
    }
</style>
