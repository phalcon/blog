---
/**
 * The logos of the supporters box of the shared sidebar (Sidebar.astro), with
 * the classes of public/css/sidebar.css.
 *
 * The roster comes from src/sponsors.json, refreshed from phalcon/assets by
 * the deploy workflow the way the fan art is. Imported rather than injected
 * with `set:html`: malformed JSON fails the build with a parse error, where
 * malformed HTML would render broken markup on every page. The committed copy
 * is an empty roster on purpose: a failed download then shows no logos, which
 * is visible, rather than a roster that is months out of date.
 *
 * The groups that show, and their titles, come from src/sidebar.json. An entry
 * without a logo cannot be shown here, so it is dropped. Nothing here states
 * an amount: `group` is the only signal the data carries.
 */
import data from '../sponsors.json';

interface Props {
    groups: { group: string; title: string }[];
}

interface Sponsor {
    group: string;
    id: string;
    kind: string;
    logo: string | null;
    name: string;
    source: string[];
    url: string;
}

const { groups } = Astro.props;
const sponsors = data.sponsors as Sponsor[];

const inGroup = (group: string): Sponsor[] =>
    sponsors
        .filter((sponsor) => sponsor.group === group && null !== sponsor.logo)
        .sort((a, b) => a.name.localeCompare(b.name));
---

{groups.map(({ group, title }) => {
    const entries = inGroup(group);

    return entries.length > 0 && (
        <div class="ph-side__group">
            <div class="ph-side__group-title">{title}</div>
            <ul class="ph-side__logos">
                {entries.map((sponsor) => (
                    <li class="ph-side__logo">
                        <a
                            href={sponsor.url}
                            rel="noopener sponsored"
                            target="_blank"
                            class="ph-side__logo-link"
                        >
                            <img
                                src={sponsor.logo}
                                alt={sponsor.name}
                                loading="lazy"
                                class="ph-side__logo-img"
                            />
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    );
})}
