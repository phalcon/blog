---
/**
 * The logos of the supporters box of the shared sidebar (Sidebar.astro), with
 * the classes of public/css/sidebar.css.
 *
 * The roster is src/sponsors.json. The deploy workflow gets it again from
 * phalcon/assets before each build, as it does for the fan art. This file
 * imports the roster. It does not add the roster as HTML with `set:html`.
 * JSON that is not correct stops the build with an error. HTML that is not
 * correct shows broken markup on every page. The committed copy is an empty
 * roster on purpose: when the download fails, the box shows no logos. You can
 * see this easily, and an empty box is better than a roster that is months old.
 *
 * src/sidebar.json gives the groups that show, and their titles. An entry
 * that has no logo cannot show here, so this file removes it. This file shows
 * no amount: in the data, the `group` is the only sign of the support level.
 */
import data from '../sponsors.json';

interface Props {
    groups: { group: string; title: string }[];
}

interface Sponsor {
    group: string;
    id: string;
    kind: string;
    logo: string | null;
    name: string;
    source: string[];
    url: string;
}

const { groups } = Astro.props;
const sponsors = data.sponsors as Sponsor[];

const inGroup = (group: string): Sponsor[] =>
    sponsors
        .filter((sponsor) => sponsor.group === group && null !== sponsor.logo)
        .sort((a, b) => a.name.localeCompare(b.name));
---

{groups.map(({ group, title }) => {
    const entries = inGroup(group);

    return entries.length > 0 && (
        <div class="ph-side__group">
            <div class="ph-side__group-title">{title}</div>
            <ul class="ph-side__logos">
                {entries.map((sponsor) => (
                    <li class="ph-side__logo">
                        <a
                            href={sponsor.url}
                            rel="noopener sponsored"
                            target="_blank"
                            class="ph-side__logo-link"
                        >
                            <img
                                src={sponsor.logo}
                                alt={sponsor.name}
                                loading="lazy"
                                class="ph-side__logo-img"
                            />
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    );
})}
