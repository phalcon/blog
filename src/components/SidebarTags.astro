---
/*
 * Ported from Jekyll's `_includes/tags.html`, which walked a hand-maintained
 * `tags_override` list in `_config.yml` — the counts there were tallied by
 * hand and the order was whatever someone last decided.
 *
 * The list is now derived. `tagCounts()` already sorts by post count, then by
 * name, so the sidebar takes the head of it and the ordering maintains itself
 * as posts are written.
 */
import { tagSlug } from '../lib/text.mjs';
import type { TagCount } from '../lib/posts';

/** How many tags the sidebar shows. The rest live on /tags. */
const LIMIT = 20;

/*
 * Version-series tags are excluded. The corpus carries 23 of them — 0.x, 1.x,
 * 2.x, 2.0, 3.0.x and so on down to single-post entries — and by raw count
 * four of them outrank `phalcon6`, so an unfiltered list spends a fifth of the
 * sidebar on releases nobody runs any more. A rule rather than a list, because
 * a list would need an edit at every release.
 */
const isVersionSeries = (tag: string): boolean => /^\d/.test(tag);

interface Props {
    tags: TagCount[];
}

const { tags } = Astro.props;

const shown = tags.filter((item) => !isVersionSeries(item.tag)).slice(0, LIMIT);
---

<div class="phalcon-blog__right-item phalcon-blog__tags">
    <div class="phalcon-blog__title">Tags</div>
    <div class="phalcon-blog__tags-items">
        {shown.map((item) => (
            <a href={`/tags#${tagSlug(item.tag)}`} class="phalcon-blog__tags-item">
                <span>{item.tag}</span>
                <span>({item.count})</span>
            </a>
        ))}
    </div>
    <a href="/tags" class="phalcon-blog__item-read-more">Show More</a>
</div>
