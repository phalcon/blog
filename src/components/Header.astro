---
/*
 * The shared nav of the Phalcon sites: the nav of phalcon.io, with the
 * classes of public/css/common.css (a copy of phalcon/css/common.css in
 * phalcon/assets). The links are the links of phalcon.io, with absolute
 * addresses; the Blog link goes to the home page of the blog. The blog adds
 * its search box (in the links, after "Get Phalcon" and before the GitHub
 * link) and its theme switcher (between the Discord icon and the burger);
 * public/css/site.css styles them. public/js/nav.js, a copy of the script of
 * phalcon.io, opens and closes the mobile menu.
 */
import { cphalconStars, formatStars } from '../lib/stars.mjs';
import repositories from '../repositories.json?raw';
import { site } from '../site';

const links = [
    { label: 'Download', href: 'https://phalcon.io/download' },
    { label: 'Docs', href: 'https://docs.phalcon.io' },
    { label: 'Features', href: 'https://phalcon.io/#features' },
];
const menus = [
    {
        label: 'Community',
        items: [
            { label: 'Discord', href: 'https://phalcon.io/discord' },
            { label: 'Discussions (v5)', href: 'https://github.com/phalcon/cphalcon/discussions' },
            { label: 'Discussions (v6)', href: 'https://github.com/phalcon/phalcon/discussions' },
            { label: 'Stack Overflow', href: 'https://phalcon.io/so' },
            { label: 'Blog', href: '/' },
            { label: 'Support', href: 'https://phalcon.io/support' },
        ],
    },
    {
        label: 'Project',
        items: [
            { label: 'Contribute', href: 'https://phalcon.io/contribute' },
            { label: 'Team', href: 'https://phalcon.io/team' },
            { label: 'Testimonials', href: 'https://phalcon.io/testimonials' },
            { label: 'Sponsors', href: 'https://phalcon.io/sponsors' },
            { label: 'Hosting', href: 'https://phalcon.io/hosting' },
            { label: 'Built with Phalcon', href: 'https://builtwith.phalcon.io' },
        ],
    },
];
const github = 'https://github.com/phalcon/cphalcon';
/* A copy with no star count stops the build. The tests check the committed copy. */
const stars = formatStars(cphalconStars(repositories));
---

<nav class="ph-nav">
    <div class="ph-nav__bar">
        <a href="/" class="ph-nav__brand">
            <img src="https://assets.phalcon.io/phalcon/images/svg/falcon.svg" alt="" class="ph-nav__logo" />
            <span class="ph-nav__name">{site.name}</span>
        </a>

        <div class="ph-nav__end">
            <div class="ph-nav__links">
                {links.map((link) => (
                    <a href={link.href} class="ph-nav__link">{link.label}</a>
                ))}
                {menus.map((menu) => (
                    <div class="ph-nav__menu">
                        <button class="ph-nav__menu-button" aria-haspopup="true">
                            {menu.label} <span aria-hidden="true" class="ph-nav__caret">▾</span>
                        </button>
                        <div class="ph-nav__dropdown">
                            <ul class="ph-nav__dropdown-list">
                                {menu.items.map((item) => (
                                    <li><a href={item.href} class="ph-nav__dropdown-link">{item.label}</a></li>
                                ))}
                            </ul>
                        </div>
                    </div>
                ))}
                <a href="https://phalcon.io/download" class="ph-nav__cta">Get Phalcon</a>
                <div class="header__search-wrapper">
                    <input
                        type="text"
                        id="header-search-input"
                        class="header__search"
                        placeholder="Search..."
                        aria-label="Search"
                        autocomplete="off"
                    >
                    <div id="header-search-results" class="phalcon-blog-detail" hidden>
                        <div id="articles"></div>
                    </div>
                </div>
                <a href={github} class="ph-nav__github" aria-label={`GitHub, ${stars} stars`}>
                    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                    </svg>
                    <span class="ph-nav__stars">★ {stars}</span>
                </a>
            </div>

            <a href="https://phalcon.io/discord" class="ph-nav__discord" aria-label="Discord">
                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
                </svg>
            </a>

            <div class="switcher"><button aria-label="Theme switcher"></button></div>

            <button
                id="nav-burger"
                class="ph-nav__burger"
                aria-label="Toggle navigation"
                aria-expanded="false"
                aria-controls="nav-mobile"
            >
                <span class="ph-nav__burger-line"></span>
                <span class="ph-nav__burger-line"></span>
                <span class="ph-nav__burger-line"></span>
            </button>
        </div>
    </div>

    <div id="nav-mobile" hidden class="ph-nav__mobile">
        <ul class="ph-nav__mobile-list">
            {links.map((link) => (
                <li><a href={link.href} class="ph-nav__mobile-link">{link.label}</a></li>
            ))}
            {menus.map((menu) => (
                <>
                    <li class="ph-nav__mobile-heading">{menu.label}</li>
                    {menu.items.map((item) => (
                        <li><a href={item.href} class="ph-nav__mobile-link">{item.label}</a></li>
                    ))}
                </>
            ))}
            <li class="ph-nav__mobile-github">
                <a href={github} class="ph-nav__mobile-link">GitHub ★ {stars}</a>
            </li>
            <li class="ph-nav__mobile-action">
                <a href="https://phalcon.io/download" class="ph-nav__mobile-cta">Get Phalcon</a>
            </li>
        </ul>
    </div>
</nav>

<script is:inline src="/js/nav.js" defer></script>

<style>
    /*
     * The panel of the search results. public/css/site.css styles the search
     * box and the colors of the results. The panel ends at the right edge of
     * the search box and opens to the left.
     */
    .header__search-wrapper {
        position: relative;
    }

    #header-search-results {
        background: var(--nd-surface);
        border-radius: 8px;
        box-shadow: 0 8px 24px color-mix(in srgb, var(--ph-night-950) 15%, transparent);
        margin-top: 0.5rem;
        max-height: 70vh;
        overflow-y: auto;
        position: absolute;
        right: 0;
        top: 100%;
        width: 24rem;
        z-index: 20;
    }
</style>

<script>
    /*
     * The theme switcher, ported from the `theme.min.js` that
     * `assets.phalcon.io` serves, so that the site carries no remote script of
     * its own. The behavior is the one that file has, including the shape of
     * the cycle: from `auto` a click selects the tone the system is not on, and
     * the click after that returns to `auto`.
     *
     * That file also marks `[data-mode]` buttons as active. This markup has no
     * such button, so that part is not ported.
     *
     * `Meta.astro` keeps a separate inline copy of the class switch. It has to
     * run before the first paint, which a bundled module cannot do.
     */
    type Mode = 'auto' | 'dark' | 'light';
    type Tone = 'dark' | 'light';

    const root = document.documentElement;
    const darkQuery = matchMedia('(prefers-color-scheme: dark)');

    const systemTone = (): Tone => (darkQuery.matches ? 'dark' : 'light');
    const storedMode = (): Mode => (localStorage.getItem('mode') as Mode | null) ?? 'auto';

    const apply = (mode: Mode): void => {
        const tone = mode === 'auto' ? systemTone() : mode;

        root.style.colorScheme = mode === 'auto' ? 'light dark' : tone;
        root.classList.remove('light', 'dark');
        root.classList.add(tone);
        localStorage.setItem('mode', mode);

        /* site.css draws the moon and the sun on `.switcher-light`
           and `.switcher-dark` with `::before`. */
        document.querySelectorAll('.switcher').forEach((switcher) => {
            switcher.classList.remove('switcher-light', 'switcher-dark');
            switcher.classList.add(`switcher-${tone}`);
        });
    };

    document.querySelectorAll('.switcher').forEach((switcher) => {
        switcher.addEventListener('click', () => {
            apply(storedMode() === 'auto'
                ? (systemTone() === 'light' ? 'dark' : 'light')
                : 'auto');
        });
    });

    darkQuery.addEventListener('change', () => {
        if (storedMode() === 'auto') {
            apply('auto');
        }
    });

    apply(storedMode());
</script>

<script>
    import { servedPath } from '../lib/text.mjs';

    /*
     * Pagefind writes dist/pagefind/pagefind.js at build time, so this import
     * cannot resolve during `astro dev`. Loading it on first use keeps the dev
     * server working; search itself needs `npm run build && npm run preview`.
     */
    interface PagefindResultData {
        excerpt: string;
        meta: { date?: string; title?: string };
        url: string;
    }

    interface PagefindApi {
        search(term: string): Promise<{ results: Array<{ data(): Promise<PagefindResultData> }> }>;
    }

    let pagefind: PagefindApi | undefined;

    async function load(): Promise<PagefindApi> {
        if (pagefind === undefined) {
            pagefind = (await import(
                /* @vite-ignore */ new URL('pagefind/pagefind.js', window.location.origin).href
            )) as PagefindApi;
        }

        return pagefind;
    }

    const input = document.getElementById('header-search-input') as HTMLInputElement | null;
    const panel = document.getElementById('header-search-results');
    const list = document.getElementById('articles');

    if (input && panel && list) {
        let debounce: ReturnType<typeof setTimeout> | undefined;

        const renderRow = (data: PagefindResultData): string => {
            const href = servedPath(data.url);

            return `
            <div class="phalcon-blog__item">
                <div class="phalcon-blog__item-content">
                    <div class="phalcon-blog__item-title">
                        <a href="${href}">${data.meta.title ?? 'Untitled'}</a>
                    </div>
                    ${data.meta.date ? `<div class="phalcon-blog__item-date">${data.meta.date}</div>` : ''}
                    <div class="phalcon-blog__item-article">${data.excerpt}</div>
                </div>
            </div>
        `;
        };

        const runSearch = async (term: string): Promise<void> => {
            const api = await load();
            const search = await api.search(term);
            const rows = await Promise.all(search.results.slice(0, 10).map((result) => result.data()));

            list.innerHTML = rows.length > 0
                ? rows.map(renderRow).join('')
                : '<p>No results found.</p>';
            panel.hidden = false;
        };

        input.addEventListener('input', () => {
            const term = input.value.trim();

            clearTimeout(debounce);

            if (term.length === 0) {
                panel.hidden = true;
                list.innerHTML = '';
                return;
            }

            debounce = setTimeout(() => {
                runSearch(term).catch(() => {
                    panel.hidden = true;
                });
            }, 150);
        });

        document.addEventListener('click', (event) => {
            if (!(event.target instanceof Node)) {
                return;
            }

            if (!panel.contains(event.target) && event.target !== input) {
                panel.hidden = true;
            }
        });

        input.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                panel.hidden = true;
                input.focus();
            }
        });
    }
</script>
